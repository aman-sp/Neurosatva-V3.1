{
  "version": 2,
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.9.0"
    }
  },
  "rewrites": [
    {
      "source": "/assets/:path*",
      "destination": "/neurosatva/public/assets/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/api/index.php"
    }
  ]
}

