DirectoryIndex index.php
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Prevent direct access to protected directories
    RewriteRule ^(\.git|\.env|app|config|database|storage)(/.*)?$ - [F,L]

    # Serve public assets directly if accessed via /assets/
    RewriteRule ^assets/(.*)$ public/assets/$1 [L]

    # If the request is for an existing file or directory, serve it
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Route all other traffic to public/index.php
    RewriteRule ^(.*)$ public/index.php [QSA,L]
</IfModule>

