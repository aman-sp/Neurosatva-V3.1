APP_NAME=Neurosatva
APP_URL=https://your-domain.com
APP_ENV=production
APP_DEBUG=false

# If your host (e.g. Railway/Render) provides a single DATABASE_URL, set this:
# DATABASE_URL=mysql://user:password@host:port/dbname

# Or configure individual MySQL credentials:
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=neurosatva
DB_USER=root
DB_PASS=

# Optional: set FRONTEND_URL if using split Vercel frontend (e.g. https://neurosatva.vercel.app)
FRONTEND_URL=

ADMIN_VIDEO_EMAIL=videos@neurosatva.local
ADMIN_NOTIFICATION_EMAIL=admin@neurosatva.local
RESEND_API_KEY=
RESEND_FROM_EMAIL=Neurosatva <onboarding@resend.dev>
STORAGE_DISK=server

