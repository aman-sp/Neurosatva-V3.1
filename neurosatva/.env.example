APP_NAME=Neurosatva
# Local: http://localhost/neurosatva  |  Production: https://neurosatva-v3.vercel.app (or your domain)
APP_URL=https://neurosatva-v3.vercel.app
APP_ENV=production
APP_DEBUG=false
# Increment this on each deploy for cache-busting (used on read-only cloud filesystems)
APP_VERSION=1

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=neurosatva
DB_USER=root
DB_PASS=

ADMIN_VIDEO_EMAIL=videos@neurosatva.local
ADMIN_NOTIFICATION_EMAIL=contactus@raaksapphire.com
RESEND_API_KEY=
RESEND_FROM_EMAIL=Neurosatva <onboarding@resend.dev>
STORAGE_DISK=r2
# Cloudflare R2 Configuration (S3-compatible, no 50MB limit, 0 Railway RAM usage)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=modules
R2_PUBLIC_URL=
# Fallback / Supabase Configuration
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_BUCKET=modules
