APP_NAME=Neurosatva
# Local: http://localhost/neurosatva  |  Production: https://neurosatva-v3.vercel.app (or your domain)
APP_URL=https://neurosatva-v3.vercel.app
APP_ENV=production
APP_DEBUG=false
# Increment this on each deploy for cache-busting (used on read-only cloud filesystems)
APP_VERSION=1

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=neurosatva
DB_USER=root
DB_PASS=

ADMIN_VIDEO_EMAIL=videos@neurosatva.local
ADMIN_NOTIFICATION_EMAIL=contactus@raaksapphire.com
RESEND_API_KEY=
RESEND_FROM_EMAIL=Neurosatva <onboarding@resend.dev>
STORAGE_DISK=server
